{
    "id": "claude-code-native",
    "version": "1.1.0",
    "name": "Claude Code (native installer)",
    "documentationURL": "https://github.com/lukewiwa/debian-features/tree/main/src/claude-code-native",
    "description": "Claude Code is an agentic coding tool that lives in your terminal. Installs via the official native installer and keeps its config and login in a per-project volume, isolated from the host.",
    "options": {
        "version": {
            "default": "latest",
            "description": "Version to install: 'stable', 'latest', or a specific semantic version (e.g., '1.2.3')",
            "proposals": [
                "latest",
                "stable"
            ],
            "type": "string"
        }
    },
    "entrypoint": "/usr/local/share/claude-code-native/entrypoint.sh",
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/usr/local/share/claude-config"
    },
    "mounts": [
        {
            "source": "claude-code-config-${devcontainerId}",
            "target": "/usr/local/share/claude-config",
            "type": "volume"
        }
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code"
            ]
        }
    },
    "dependsOn": {
        "ghcr.io/devcontainers-extra/features/curl-apt-get:1": {}
    }
}
