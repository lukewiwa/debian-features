{
    "id": "homebrew-packages",
    "version": "1.1.0",
    "name": "Homebrew packages",
    "documentationURL": "https://github.com/lukewiwa/debian-features/tree/main/src/homebrew-packages",
    "description": "Installs a list of Homebrew packages, like a Brewfile, in one feature. Installs Homebrew first, without cloning homebrew-core.",
    "options": {
        "packages": {
            "type": "string",
            "default": "",
            "description": "Space- or comma-separated Homebrew formulae to install, e.g. 'bat git-delta fzf'"
        }
    },
    "entrypoint": "/usr/local/share/homebrew-packages/entrypoint.sh",
    "containerEnv": {
        "HOMEBREW_PREFIX": "/home/linuxbrew/.linuxbrew",
        "HOMEBREW_CELLAR": "/home/linuxbrew/.linuxbrew/Cellar",
        "HOMEBREW_REPOSITORY": "/home/linuxbrew/.linuxbrew/Homebrew",
        "PATH": "/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:${PATH}"
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
